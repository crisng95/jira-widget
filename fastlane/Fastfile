default_platform(:mac)

platform :mac do
  desc "Đẩy metadata lên App Store Connect (không binary, không screenshots)"
  lane :push_metadata do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID", "883W4Z3Z99"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch(
        "ASC_KEY_PATH",
        File.expand_path("~/.appstoreconnect/private_keys/AuthKey_883W4Z3Z99.p8")
      )
    )
    deliver(platform: "osx")
  end
end
